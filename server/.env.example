# ═══════════════════════════════════════════════════════
# FX CRM — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

# Database (get from Supabase → Settings → Database → Connection string URI)
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Auth
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Server
PORT=4000
NODE_ENV=development

# WhatsApp - Twilio (optional, add later)
# TWILIO_SID=ACxxxxx
# TWILIO_TOKEN=xxxxx
# TWILIO_WHATSAPP=+14155238886

# Google Calendar/Meet (optional, add later)
# GOOGLE_CLIENT_ID=xxxxx
# GOOGLE_CLIENT_SECRET=xxxxx
